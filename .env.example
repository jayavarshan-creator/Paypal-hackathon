# ==========================================
# PayIntellect AI - Environment Variables
# ==========================================

# GEMINI_API_KEY: Required for Gemini 3.8 Flash AI operations
# (Deal negotiation, Invoicing parser, Dispute analysis, Webhook insights).
# - On Google AI Studio: Injected automatically from user secrets.
# - On Vercel: Add this in Project Settings > Environment Variables.
# - Locally: Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PAYPAL_CLIENT_ID: PayPal Developer Sandbox Client ID.
# - For default testing: you can leave as "test" (PayPal official sandbox demo client ID).
# - For custom sandbox accounts: generate in https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID="test"

# APP_URL: The public hosted URL for self-referential links & callbacks.
# - On Vercel: Vercel automatically sets VERCEL_URL, or set this to your custom domain.
APP_URL="http://localhost:3000"
